#:include tubo.kv
#:import dp kivy.metrics.dp

FloatLayout:
    Background:
        id: background
        canvas.before:
            Rectangle:
                size: self.size
                pos: self.pos
                source: "cielo.png"
            Rectangle: #nubes
                size: self.width, dp(150)
                pos: self.pos[0], self.pos[1] + self.height - dp(150)
                texture: self.textura_nube
            Rectangle: #piso
                size: self.width, dp(100)
                pos: self.pos[0], self.pos[1] 
                texture: self.textura_sopi
    Label:
        id: score
        size_hint_y: None
        height: dp(100)
        text: "0"
        font_size: sp(40)
    Button:
        text: "JUGAR"
        background_normal: "transparent.png"
        background_down: "transparent.png"
        id: start_button
        on_release:
            self.disabled = True
            self.opacity = 0
            app.start_game()
    Bird:
        source: "bird1.png"
        size_hint: None, None
        size: dp(46), dp(34)
        pos: dp(20), (root.height - dp(100)) / 2.0
        id: bird
